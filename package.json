{
  "name": "flight-cap-demo",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/sqlite": "^2.4.3"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-flightsop": "cds watch --open sap.fe.demo.flightsop/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy flight-cap-demo --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/flightsop"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "auth": "dummy",
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      }
    },
    "features": {
      "[production]": {
        "in_memory_db": true
      }
    }
  }
}
